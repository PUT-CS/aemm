            },
            {
              "id": "e9bc8fcc-d9e9-4288-a8c4-a5bb08a13b0d",
              "type": "Image",
              "props": {
                "src": "https://upload.wikimedia.org/wikipedia/commons/thumb/f/f2/Portrait_Hippopotamus_in_the_water.jpg/2560px-Portrait_Hippopotamus_in_the_water.jpg",
                "alt": "Placeholder image",
